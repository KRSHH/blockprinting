---
import '../styles/global.css';
import SeoHead, { type Props as SeoProps } from '../components/SeoHead.astro';
import { SITE } from '../config/site';

interface NavLink {
  label: string;
  href: string;
}

interface Props extends SeoProps {
  prev?: NavLink;
  next?: NavLink;
}

const { prev, next, ...seoProps } = Astro.props;
const currentPath = Astro.url.pathname;
const year = new Date().getUTCFullYear();

const navItems = [
  { label: 'Encyclopedia', href: '/guides/' },
  { label: 'Archive', href: '/archive/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'Calculator', href: '/tools/yardage-calculator/' },
  { label: 'Jeremy Fritzhand', href: '/about/' },
];
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <SeoHead {...seoProps} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-black"
    >
      Skip to main content
    </a>

    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href="/" class="site-brand">Blockprinting.org</a>

        <nav aria-label="Primary navigation" class="site-nav">
          {
            navItems.map((item) => {
              const active = currentPath.startsWith(item.href);
              return (
                <a href={item.href} aria-current={active ? 'page' : undefined}>
                  {item.label}
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    {
      (prev || next) && (
        <nav
          aria-label="Chapter sequence"
          style="border-top: 2px solid var(--rule); background: var(--surface);"
        >
          <div
            class="wrap font-ui"
            style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem; font-size: 0.82rem;"
          >
            <div>
              {prev && (
                <a href={prev.href} style="font-weight: 600;">
                  &larr; {prev.label}
                </a>
              )}
            </div>
            <div>
              <a href="/guides/" style="color: var(--ink-muted);">
                All chapters
              </a>
            </div>
            <div style="text-align: right;">
              {next && (
                <a href={next.href} style="font-weight: 600;">
                  {next.label} &rarr;
                </a>
              )}
            </div>
          </div>
        </nav>
      )
    }

    <footer class="band-dark" style="border-top: 1px solid #2b2b28; padding: 4rem 0 3rem;">
      <div class="wrap">
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; padding-bottom: 3rem; border-bottom: 1px solid #2b2b28;"
        >
          <div>
            <p class="font-display" style="font-size: 2rem; font-weight: 700; margin: 0;">
              Blockprinting.org
            </p>
            <p
              class="font-ui"
              style="margin-top: 0.75rem; font-size: 0.82rem; line-height: 1.6; color: var(--muted-on-dark); max-width: 24rem;"
            >
              An open, ad-free visual encyclopedia of hand block printing, carved woodblocks,
              natural dye chemistry, and cultural intellectual property—authored by{' '}
              <a href="/about/" style="color: #fff; text-decoration: underline;">
                Jeremy Fritzhand
              </a>{' '}
              from sixteen years in Bagru, Rajasthan.
            </p>
          </div>

          <div class="font-ui" style="font-size: 0.82rem;">
            <p style="font-weight: 600; margin: 0 0 0.75rem; color: #fff;">Encyclopedia</p>
            <ul style="list-style: none; margin: 0; padding: 0; line-height: 2; color: var(--muted-on-dark);">
              <li><a href="/guides/block-printing-in-ten-minutes/">Block printing in ten minutes</a></li>
              <li><a href="/guides/real-vs-fake-block-printing/">Authenticity standard</a></li>
              <li><a href="/guides/bagru-dabu-mud-resist-printing/">Bagru &amp; dabu mud-resist</a></li>
              <li><a href="/glossary/">Glossary of 24 workshop terms</a></li>
              <li><a href="/archive/">Photographic archive</a></li>
              <li><a href="/tools/yardage-calculator/">Yardage &amp; strike calculator</a></li>
            </ul>
          </div>

          <div class="font-ui" style="font-size: 0.82rem;">
            <p style="font-weight: 600; margin: 0 0 0.75rem; color: #fff;">Jeremy Fritzhand</p>
            <ul style="list-style: none; margin: 0; padding: 0; line-height: 2; color: var(--muted-on-dark);">
              <li><a href="/about/">Biography &amp; field timeline</a></li>
              <li>
                <a href="https://studiobagru.com" target="_blank" rel="me noopener noreferrer">
                  Studio Bagru (artisan directory)
                </a>
              </li>
              <li>
                <a href="https://fritzmfg.com" target="_blank" rel="me noopener noreferrer">
                  Fritz MFG (sourcing &amp; workshops)
                </a>
              </li>
              <li>
                <a href="https://fritzhand.com" target="_blank" rel="me noopener noreferrer">
                  fritzhand.com
                </a>
              </li>
              <li>
                <a href="https://github.com/fritzhand" target="_blank" rel="me noopener noreferrer">
                  github.com/fritzhand
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="font-ui"
          style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1.5rem; font-size: 0.75rem; color: var(--muted-on-dark);"
        >
          <p style="margin: 0;">&copy; {year} Jeremy Fritzhand &mdash; Blockprinting.org</p>
          <div style="display: flex; gap: 1.25rem;">
            <a href="/rss.xml">RSS</a>
            <a href="/sitemap-index.xml">Sitemap</a>
            <a href="/llms.txt">llms.txt</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
