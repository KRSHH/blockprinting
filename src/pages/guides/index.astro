---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { estimateReadingTime } from '../../lib/seo';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const breadcrumbs = [
  { name: 'Contents', href: '/' },
  { name: 'All chapters', href: '/guides/' },
];
---

<BaseLayout
  title="All Chapters — Block Printing Reference"
  description="Complete chapter index of Blockprinting.org by Jeremy Fritzhand: woodblock carving, Bagru dabu mud-resist, natural dyes, fabric care, and ethical sourcing."
  image="/og/guides.png"
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  prev={{ label: 'Contents', href: '/' }}
  next={{ label: 'Block printing in ten minutes', href: '/guides/block-printing-in-ten-minutes/' }}
  sidenote="All nine chapters in reading order, written by Jeremy Fritzhand."
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="book-prose">
    <h1 class="chapter-title">Complete chapter index</h1>
    <p class="chapter-lead">
      Read straight through from chapter one to nine, or jump directly to any technical reference.
    </p>

    {
      SITE.parts.map((part) => {
        const items = guides.filter((g) => g.data.part === part.id);
        if (!items.length) return null;
        return (
          <section style="margin-top: 1.75rem;">
            <h2 style="margin-top: 1.5rem;">{part.label}</h2>
            <ol style="list-style: none; margin: 0; padding: 0;">
              {items.map((guide) => {
                const stats = estimateReadingTime(guide.body ?? '');
                return (
                  <li style="border-bottom: 1px solid var(--rule-light); padding: 0.85rem 0; margin: 0;">
                    <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;">
                      <a
                        href={`/guides/${guide.id}/`}
                        style="font-weight: 700; font-size: 1.05rem;"
                      >
                        {guide.data.title}
                      </a>
                      <span style="font-family: var(--font-ui), system-ui, sans-serif; font-size: 0.74rem; color: var(--ink-muted); white-space: nowrap;">
                        {stats.minutes} min
                      </span>
                    </div>
                    <p style="margin: 0.3rem 0 0 0; font-size: 0.9rem; color: var(--ink-muted);">
                      {guide.data.description}
                    </p>
                  </li>
                );
              })}
            </ol>
          </section>
        );
      })
    }
  </article>
</BaseLayout>
