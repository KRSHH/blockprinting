---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config/site';
import { CHAPTER_VISUALS } from '../../lib/images';
import { estimateReadingTime } from '../../lib/seo';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Encyclopedia', href: '/guides/' },
];
---

<BaseLayout
  title="Encyclopedia — All Nine Chapters on Block Printing"
  description="Complete chapter index of Blockprinting.org by Jeremy Fritzhand: woodblock carving, Bagru dabu mud-resist, natural dyes, fabric care, and ethical sourcing."
  image="/og/guides.png"
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  prev={{ label: 'Home', href: '/' }}
  next={{ label: 'Block printing in ten minutes', href: '/guides/block-printing-in-ten-minutes/' }}
>
  <section class="wrap" style="padding-top: 2.5rem; padding-bottom: 5rem;">
    <Breadcrumbs items={breadcrumbs} />

    <div class="editorial-bar">
      <span>Complete Chapter Index — 9 illustrated chapters</span>
      <span>Authored by Jeremy Fritzhand</span>
    </div>

    <h1
      class="font-display"
      style="font-size: clamp(2.6rem, 6vw, 4.8rem); font-weight: 700; margin: 1.5rem 0 2.75rem;"
    >
      The Encyclopedia
    </h1>

    {
      SITE.parts.map((part) => {
        const items = guides.filter((g) => g.data.part === part.id);
        if (!items.length) return null;
        return (
          <section style="margin-bottom: 3.5rem;">
            <div
              class="font-ui"
              style="border-top: 2px solid var(--rule); padding-top: 0.65rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;"
            >
              <span>{part.label}</span>
              <span style="color: var(--ink-muted);">{items.length} chapter{items.length > 1 ? 's' : ''}</span>
            </div>

            <div
              style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;"
            >
              {items.map((guide) => {
                const visual = CHAPTER_VISUALS[guide.id];
                const stats = estimateReadingTime(guide.body ?? '');
                return (
                  <a href={`/guides/${guide.id}/`} class="specimen-plate">
                    <div>
                      <div
                        class="font-ui plate-muted"
                        style="display: flex; justify-content: space-between; font-size: 0.72rem; margin-bottom: 0.65rem;"
                      >
                        <span>CHAPTER {String(guide.data.order).padStart(2, '0')}</span>
                        <span>{stats.minutes} MIN READ</span>
                      </div>
                      <h2
                        class="font-display"
                        style="font-size: 1.65rem; font-weight: 700; margin: 0 0 0.6rem; line-height: 1.04;"
                      >
                        {guide.data.title}
                      </h2>
                      <p class="plate-muted" style="font-size: 0.9rem; line-height: 1.5; margin: 0 0 1.25rem;">
                        {guide.data.description}
                      </p>
                    </div>
                    {visual && (
                      <div class="plate-media" style="aspect-ratio: 16 / 10;">
                        <Image src={visual.image} alt={visual.alt} width={640} quality={82} />
                      </div>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        );
      })
    }
  </section>
</BaseLayout>
