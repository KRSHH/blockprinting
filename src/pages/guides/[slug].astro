---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import { SITE } from '../../config/site';
import { CHAPTER_VISUALS, PHOTOS } from '../../lib/images';
import { estimateReadingTime, formatDate } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );

  return guides.map((guide, index) => {
    const prevGuide = index > 0 ? guides[index - 1] : null;
    const nextGuide = index < guides.length - 1 ? guides[index + 1] : null;
    return {
      params: { slug: guide.id },
      props: { guide, prevGuide, nextGuide, chapterNum: index + 1 },
    };
  });
}

const { guide, prevGuide, nextGuide, chapterNum } = Astro.props;
const { Content, headings } = await render(guide);
const stats = estimateReadingTime(guide.body ?? '');
const tocHeadings = headings.filter((h) => h.depth === 2);
const visual = CHAPTER_VISUALS[guide.id];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Encyclopedia', href: '/guides/' },
  { name: guide.data.shortTitle ?? guide.data.title, href: `/guides/${guide.id}/` },
];

const prevLink = prevGuide
  ? { label: prevGuide.data.shortTitle ?? prevGuide.data.title, href: `/guides/${prevGuide.id}/` }
  : { label: 'Encyclopedia home', href: '/' };

const nextLink = nextGuide
  ? { label: nextGuide.data.shortTitle ?? nextGuide.data.title, href: `/guides/${nextGuide.id}/` }
  : { label: 'Photographic archive', href: '/archive/' };
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  canonicalUrl={guide.data.canonicalUrl}
  image={`/og/guides/${guide.id}.png`}
  imageAlt={guide.data.title}
  ogType="article"
  publishedAt={guide.data.publishedAt}
  updatedAt={guide.data.updatedAt}
  author={guide.data.author}
  section={guide.data.category}
  tags={guide.data.tags}
  wordCount={stats.words}
  timeRequired={stats.isoDuration}
  breadcrumbs={breadcrumbs}
  faqs={guide.data.faqs}
  prev={prevLink}
  next={nextLink}
  howTo={
    guide.data.howToSteps
      ? {
          name: guide.data.title,
          description: guide.data.description,
          totalTime: stats.isoDuration,
          steps: guide.data.howToSteps,
        }
      : undefined
  }
>
  <article class="wrap-reading" style="padding-top: 2.5rem; padding-bottom: 5rem;">
    <Breadcrumbs items={breadcrumbs} />

    <div class="editorial-bar">
      <span>Chapter {String(chapterNum).padStart(2, '0')} — {guide.data.category}</span>
      <span>{stats.minutes} min read · {stats.words.toLocaleString()} words</span>
    </div>

    <header style="margin-top: 1.5rem; margin-bottom: 2.25rem;">
      <h1
        class="font-display"
        style="font-size: clamp(2.4rem, 5.5vw, 4.4rem); font-weight: 700; margin: 0; max-width: 54rem;"
      >
        {guide.data.title}
      </h1>
      <p style="margin: 1.15rem 0 0; font-size: 1.18rem; line-height: 1.52; color: var(--ink-muted); max-width: 44rem;">
        {guide.data.description}
      </p>
      <div
        class="font-ui"
        style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 1.25rem; font-size: 0.8rem; color: var(--ink-muted);"
      >
        <span>
          By <a href="/about/" style="color: var(--ink); font-weight: 600; text-decoration: underline;">{guide.data.author}</a>
        </span>
        <span aria-hidden="true">/</span>
        <time datetime={guide.data.publishedAt.toISOString()}>
          {formatDate(guide.data.publishedAt)}
        </time>
      </div>
    </header>

    {
      visual && (
        <figure class="museum-figure" style="margin-top: 0; margin-bottom: 3rem;">
          <div style="overflow: hidden; border: 1px solid var(--rule-light); max-height: 540px; background: #141413;">
            <Image
              src={visual.image}
              alt={visual.alt}
              width={1200}
              quality={86}
              fetchpriority="high"
              loading="eager"
              style="width: 100%; height: 100%; max-height: 540px; object-fit: cover;"
            />
          </div>
          <figcaption>
            <span>{visual.caption}</span>
            <span>{visual.credit}</span>
          </figcaption>
        </figure>
      )
    }

    <div class="article-grid">
      <div class="book-prose">
        <Content />

        {guide.data.faqs && guide.data.faqs.length > 0 && <FaqSection items={guide.data.faqs} />}
      </div>

      <!-- Sticky Right Rail: Field Sidenote, Section Outline, Author Card -->
      <aside
        aria-label="Chapter notes"
        style="position: sticky; top: 5rem; display: flex; flex-direction: column; gap: 1.75rem;"
      >
        {
          guide.data.sidenote && (
            <div
              class="font-ui"
              style="border-top: 3px solid var(--madder); padding-top: 0.75rem; font-size: 0.82rem; line-height: 1.55; color: var(--ink);"
            >
              <strong style="display: block; font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--madder); margin-bottom: 0.35rem;">
                Field note
              </strong>
              {guide.data.sidenote}
            </div>
          )
        }

        {
          tocHeadings.length > 0 && (
            <nav
              aria-label="In this chapter"
              class="font-ui"
              style="border-top: 1px solid var(--rule-light); padding-top: 0.85rem; font-size: 0.8rem;"
            >
              <p style="font-weight: 700; margin: 0 0 0.6rem; color: var(--ink);">Sections</p>
              <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.45rem; color: var(--ink-muted);">
                {tocHeadings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} style="transition: color 0.15s ease;">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div
          class="font-ui"
          style="background: var(--surface); border: 1px solid var(--rule-light); padding: 1rem; font-size: 0.78rem; line-height: 1.5;"
        >
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
            <Image
              src={PHOTOS.jeremy2026}
              alt="Jeremy Fritzhand"
              width={96}
              height={96}
              style="width: 48px; height: 48px; object-fit: cover; border: 1px solid var(--rule-light);"
            />
            <div>
              <a href="/about/" style="font-weight: 700; color: var(--ink); display: block;">
                {SITE.author.name}
              </a>
              <span style="color: var(--ink-muted); font-size: 0.72rem;">
                Studio Bagru &amp; Fritz MFG
              </span>
            </div>
          </div>
          <p style="margin: 0; color: var(--ink-muted);">
            Sixteen years working with Bagru’s <em>Chhipa</em> printers and block carvers. For
            sourcing or workshops, visit{' '}
            <a href="https://fritzmfg.com" target="_blank" rel="noopener noreferrer" style="color: var(--ink); text-decoration: underline;">
              Fritz MFG
            </a>.
          </p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
