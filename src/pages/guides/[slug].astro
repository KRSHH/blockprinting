---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import { SITE } from '../../config/site';
import { estimateReadingTime, formatDate } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );

  return guides.map((guide, index) => {
    const prevGuide = index > 0 ? guides[index - 1] : null;
    const nextGuide = index < guides.length - 1 ? guides[index + 1] : null;
    return {
      params: { slug: guide.id },
      props: { guide, prevGuide, nextGuide },
    };
  });
}

const { guide, prevGuide, nextGuide } = Astro.props;
const { Content, headings } = await render(guide);
const stats = estimateReadingTime(guide.body ?? '');
const tocHeadings = headings.filter((h) => h.depth === 2);

const breadcrumbs = [
  { name: 'Contents', href: '/' },
  { name: guide.data.category, href: '/guides/' },
  { name: guide.data.shortTitle ?? guide.data.title, href: `/guides/${guide.id}/` },
];

const prevLink = prevGuide
  ? { label: prevGuide.data.shortTitle ?? prevGuide.data.title, href: `/guides/${prevGuide.id}/` }
  : { label: 'contents', href: '/' };

const nextLink = nextGuide
  ? { label: nextGuide.data.shortTitle ?? nextGuide.data.title, href: `/guides/${nextGuide.id}/` }
  : { label: 'glossary', href: '/glossary/' };
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  canonicalUrl={guide.data.canonicalUrl}
  image={`/og/guides/${guide.id}.png`}
  imageAlt={guide.data.title}
  ogType="article"
  publishedAt={guide.data.publishedAt}
  updatedAt={guide.data.updatedAt}
  author={guide.data.author}
  section={guide.data.category}
  tags={guide.data.tags}
  wordCount={stats.words}
  timeRequired={stats.isoDuration}
  breadcrumbs={breadcrumbs}
  faqs={guide.data.faqs}
  prev={prevLink}
  next={nextLink}
  sidenote={guide.data.sidenote}
  howTo={
    guide.data.howToSteps
      ? {
          name: guide.data.title,
          description: guide.data.description,
          totalTime: stats.isoDuration,
          steps: guide.data.howToSteps,
        }
      : undefined
  }
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="book-prose">
    <h1 class="chapter-title">{guide.data.title}</h1>

    <p
      style="font-family: var(--font-ui), system-ui, sans-serif; font-size: 0.78rem; color: var(--ink-muted); margin-bottom: 1.5rem;"
    >
      By <a href="/about/" style="color: var(--ink); font-weight: 500;">{guide.data.author}</a>
      &ensp;/&ensp;
      <time datetime={guide.data.publishedAt.toISOString()}>
        {formatDate(guide.data.publishedAt)}
      </time>
      &ensp;/&ensp;
      {stats.minutes} min read ({stats.words.toLocaleString()} words)
    </p>

    {
      tocHeadings.length > 2 && (
        <nav aria-label="Chapter sections" class="reader-note">
          <strong>Sections:</strong>{' '}
          {tocHeadings.map((heading, idx) => (
            <>
              {idx > 0 && <span aria-hidden="true"> / </span>}
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </>
          ))}
        </nav>
      )
    }

    <Content />

    <div class="reader-note" style="margin-top: 2.5rem;">
      <strong>About the author:</strong>{' '}
      <a href="/about/">{SITE.author.name}</a> {SITE.author.bio.replace(`${SITE.author.name} `, '')}
      {' '}For workshops, sustainable sourcing, or production inquiries, visit{' '}
      <a href="https://fritzmfg.com" target="_blank" rel="noopener noreferrer">Fritz MFG</a> or the{' '}
      <a href="https://studiobagru.com" target="_blank" rel="noopener noreferrer">Studio Bagru</a>{' '}
      artisan directory.
    </div>

    {guide.data.faqs && guide.data.faqs.length > 0 && <FaqSection items={guide.data.faqs} />}
  </article>
</BaseLayout>
