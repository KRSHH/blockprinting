---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE } from '../config/site';

const allGuides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const guidesByPart = (partId: string) => allGuides.filter((g) => g.data.part === partId);

const homeFaqs = [
  {
    question: 'Who wrote Blockprinting.org?',
    answer:
      'Blockprinting.org is written by Jeremy Fritzhand, who arrived in Bagru, Rajasthan in 2010 as a Minerva Fellow from Union College and founded Studio Bagru and Fritz MFG to build direct, ethical partnerships between traditional Indian block printers and independent designers worldwide.',
  },
  {
    question: 'Where should I start if I am new to hand block printing?',
    answer:
      'Read Block printing in ten minutes for the five structural rules of the craft, then read the Authenticity standard to learn how to tell hand-carved woodblock cloth apart from screen-printed imitations.',
  },
  {
    question: 'How does Bagru printing differ from Sanganer and Ajrakh?',
    answer:
      'Bagru is defined by earthy natural-ground dyes and dabu mud-resist printing practiced by the Chhipa community; Sanganer specializes in delicate floral motifs on bright white cotton; and Ajrakh from Kutch is a 14-to-16-step double-sided resist craft anchored in deep indigo and madder red.',
  },
];
---

<BaseLayout
  isHome
  title={SITE.title}
  description={SITE.description}
  image="/og/home.png"
  faqs={homeFaqs}
  next={{ label: 'Block printing in ten minutes', href: '/guides/block-printing-in-ten-minutes/' }}
>
  <article>
    <hr class="book-rule-heavy" />

    <h1 class="sr-only">Jeremy Fritzhand’s Block Printing — Table of Contents</h1>

    <p
      class="chapter-lead"
      style="margin-top: 1.15rem; margin-bottom: 1.35rem; max-width: 35rem;"
    >
      An open, ad-free technical reference on traditional hand block printing, carved teak
      woodblocks, Bagru <em>dabu</em> mud-resist, natural dye chemistry, and ethical craft—written
      from the workshop floor by{' '}
      <a href="/about/" style="text-decoration: underline; text-decoration-color: var(--rule-light); text-underline-offset: 0.18em;">
        Jeremy Fritzhand
      </a>.
    </p>

    <hr class="book-rule-thin" />

    <!-- Direct Start Links (Butterick's iconic top two chapters) -->
    <div style="margin-top: 1.15rem;">
      {
        guidesByPart('start').map((guide) => (
          <h2 class="toc-part" style="margin-top: 0.85rem; margin-bottom: 0.35rem;">
            <a href={`/guides/${guide.id}/`}>{guide.data.shortTitle ?? guide.data.title}</a>
          </h2>
        ))
      }
    </div>

    <!-- Remaining Book Parts in 2-column TOC -->
    {
      SITE.parts
        .filter((part) => part.id !== 'start')
        .map((part) => {
          const items = guidesByPart(part.id);
          return (
            <section>
              <h2 class="toc-part">{part.label}</h2>
              <ul class="toc-list">
                {items.map((guide) => (
                  <li>
                    <a href={`/guides/${guide.id}/`}>{guide.data.shortTitle ?? guide.data.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
    }

    <!-- Reference & Studio Utilities -->
    <section>
      <h2 class="toc-part">Reference &amp; studio tools</h2>
      <ul class="toc-list">
        <li><a href="/glossary/">Glossary of 24 workshop terms</a></li>
        <li><a href="/tools/yardage-calculator/">Block repeat &amp; yardage calculator</a></li>
        <li><a href="/guides/">Complete chapter index</a></li>
        <li><a href="/about/">About Jeremy Fritzhand</a></li>
      </ul>
    </section>

    <!-- Also by Jeremy Fritzhand -->
    <section>
      <h2 class="toc-part">Also by Jeremy Fritzhand</h2>
      <ul class="toc-list toc-list--single">
        <li>
          <a href="https://fritzmfg.com" target="_blank" rel="me noopener noreferrer">
            Fritz MFG (textile practice, workshops &amp; sustainable sourcing)
          </a>
        </li>
        <li>
          <a href="https://studiobagru.com" target="_blank" rel="me noopener noreferrer">
            Studio Bagru (open directory of authentic Bagru workshops)
          </a>
        </li>
        <li>
          <a href="https://fritzhand.com" target="_blank" rel="me noopener noreferrer">
            fritzhand.com (personal site &amp; startup ecosystem leadership)
          </a>
        </li>
        <li>
          <a href="https://github.com/fritzhand" target="_blank" rel="me noopener noreferrer">
            github.com/fritzhand
          </a>
        </li>
      </ul>
    </section>

    <div
      style="border-top: 4px solid var(--rule); margin-top: 2.25rem; padding-top: 0.45rem; font-family: var(--font-display), Arial, sans-serif; text-transform: uppercase; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.02em;"
    >
      <a href="/about/">Independent, ad-free &amp; written from the workshop floor</a>
    </div>

    <FaqSection items={homeFaqs} />
  </article>
</BaseLayout>
