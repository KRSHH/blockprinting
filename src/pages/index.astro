---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WoodblockLayerDemo from '../components/WoodblockLayerDemo.astro';
import NaturalDyePalette from '../components/NaturalDyePalette.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE } from '../config/site';
import { CHAPTER_VISUALS, PHOTOS } from '../lib/images';
import { estimateReadingTime } from '../lib/seo';

const allGuides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const homeFaqs = [
  {
    question: 'Who is Jeremy Fritzhand and why did he build Blockprinting.org?',
    answer:
      'Jeremy Fritzhand arrived in Bagru, Rajasthan in 2009 on a term abroad from Union College and returned in 2010 on a Minerva Fellowship ($10,000 and a one-way ticket). He co-founded Bagru Textiles (2010), Studio Bagru (2016), Mahila Print (2018), and Fritz MFG (2023)—building this open visual encyclopedia to preserve the real craft, chemistry, and cultural IP of hand block printing.',
  },
  {
    question: 'How can you tell real hand block printing from a screen-printed fake?',
    answer:
      'Look for subtle repeat join lines every 15–25 cm, gentle ink-density shifts from strike to strike, micro-offsets (0.5–1.5 mm) between outline and filler blocks, and natural dye penetration visible on the back of lightweight cotton. Mechanical screen prints look flat and mathematically identical.',
  },
  {
    question: 'What is the difference between Bagru, Sanganer, and Ajrakh block printing?',
    answer:
      'Bagru (GI #183, Chhipa community) specializes in earthy harda-treated grounds, iron black, madder red, and dabu mud-resist. Sanganer favors delicate floral motifs and double-sided doo-rokhi on bright white cotton. Ajrakh (Khatri community of Kutch) is a 14-to-16-step double-sided geometric resist craft.',
  },
];

const processSteps = [
  {
    num: 'I',
    term: 'Thappa',
    title: 'Carved teakwood blocks',
    desc: 'Seasoned sagwan teak chiseled into matched rekh, datta, and gadh sets over 3–6 days.',
    image: PHOTOS.holdingBlocks,
    alt: 'Master printer holding a carved teakwood block over indigo medallion cloth in Bagru',
  },
  {
    num: 'II',
    term: 'Kunda & Harda',
    title: 'Mordants & felt color trays',
    desc: 'Cotton scoured in saaj and steeped in myrobalan tannin; trays charged with kashish, syahi, and alum.',
    image: PHOTOS.dyeTrays,
    alt: 'Three wooden kunda trays filled with kashish brown, syahi black, and harda yellow dye pads',
  },
  {
    num: 'III',
    term: 'Patia',
    title: 'Hand registration at the table',
    desc: 'Over 150 individual hand strikes per meter, aligned by eye to carved corner gudh pins.',
    image: PHOTOS.printerAtTable,
    alt: 'Chhipa master printer stamping carved woodblock onto black and crimson floral fabric',
  },
  {
    num: 'IV',
    term: 'Dabu & Neel',
    title: 'Mud-resist & indigo vats',
    desc: 'Black clay and sawdust shield raw cloth during repeated dips into fermented natural indigo.',
    image: PHOTOS.indigoVatDip,
    alt: 'Dabu mud-resist printed fabric lifting wet out of a deep natural indigo dye vat',
  },
  {
    num: 'V',
    term: 'Dhup',
    title: 'Wash, boil & Rajasthan sun',
    desc: 'Final madder simmer and sun-drying lock botanical color permanently inside the cotton fiber.',
    image: PHOTOS.scarvesDryingBalcony,
    alt: 'Freshly dyed crimson and saffron hand block printed scarves drying in bright sunlight',
  },
];
---

<BaseLayout
  isHome
  title={SITE.title}
  description={SITE.description}
  image="/og/home.png"
  faqs={homeFaqs}
  next={{ label: 'Block printing in ten minutes', href: '/guides/block-printing-in-ten-minutes/' }}
>
  <!-- 1. MONUMENTAL PHOTOGRAPHIC HERO (inspired by THEBE MAGUGU + Obys Grids) -->
  <section
    style="position: relative; min-height: min(88vh, 840px); display: flex; align-items: flex-end; background: var(--obsidian); color: #fff; overflow: hidden;"
  >
    <Image
      src={PHOTOS.fieldsOfColor}
      alt="Artisans stretching madder-red dyed cotton beside grids of indigo cloth in a sunlit Bagru drying field"
      width={1600}
      quality={88}
      fetchpriority="high"
      loading="eager"
      style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%;"
    />
    <div
      aria-hidden="true"
      style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(17,17,16,0.22) 0%, rgba(17,17,16,0.45) 45%, rgba(17,17,16,0.92) 100%);"
    />

    <div class="wrap" style="position: relative; z-index: 2; padding-top: 6rem; padding-bottom: 3.5rem;">
      <div
        class="font-ui"
        style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; border-top: 1px solid rgba(255,255,255,0.35); padding-top: 0.75rem; margin-bottom: 2rem; font-size: 0.78rem; letter-spacing: 0.04em; color: rgba(255,255,255,0.85);"
      >
        <span>BY JEREMY FRITZHAND · BAGRU, RAJASTHAN (2009–2026)</span>
        <span>LIVING ENCYCLOPEDIA · 9 CHAPTERS · 24 TERMS · ARCHIVE</span>
      </div>

      <h1
        class="font-display"
        style="font-size: clamp(3.6rem, 11vw, 9.2rem); font-weight: 700; margin: 0; color: #fff; letter-spacing: -0.02em; line-height: 0.88;"
      >
        Block Printing
      </h1>

      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem; align-items: end; margin-top: 2rem;"
      >
        <p style="margin: 0; font-size: 1.15rem; line-height: 1.5; color: #f0eee8; max-width: 34rem;">
          The definitive visual encyclopedia of hand-carved woodblocks, Bagru <em>dabu</em>{' '}
          mud-resist, natural dye chemistry, and artisan intellectual property—documented from
          sixteen years at the printing tables of Rajasthan.
        </p>

        <div class="font-ui" style="display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: flex-start;">
          <a
            href="/guides/block-printing-in-ten-minutes/"
            style="background: #ffffff; color: #111110; padding: 0.85rem 1.45rem; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;"
          >
            Start in ten minutes
          </a>
          <a
            href="/archive/"
            style="border: 1px solid rgba(255,255,255,0.65); color: #ffffff; padding: 0.85rem 1.45rem; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;"
          >
            Inspect photo archive
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. MUSEUM-SPECIMEN ENCYCLOPEDIA GRID (inspired by The Blimp corner crop-marks + Grids) -->
  <section class="wrap reveal" style="padding-top: 5rem; padding-bottom: 5rem;">
    <div class="editorial-bar">
      <span>The Encyclopedia — Nine illustrated chapters</span>
      <span>Written by Jeremy Fritzhand</span>
    </div>

    <div
      style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin: 1.5rem 0 2.5rem;"
    >
      <h2
        class="font-display"
        style="font-size: clamp(2.2rem, 4.5vw, 3.8rem); font-weight: 700; margin: 0;"
      >
        Read the living archive
      </h2>
      <a
        href="/guides/"
        class="font-ui"
        style="font-size: 0.82rem; font-weight: 600; border-bottom: 2px solid var(--ink); padding-bottom: 0.2rem;"
      >
        View full chapter index
      </a>
    </div>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 1.25rem;"
    >
      {
        allGuides.map((guide, index) => {
          const visual = CHAPTER_VISUALS[guide.id];
          const stats = estimateReadingTime(guide.body ?? '');
          return (
            <a href={`/guides/${guide.id}/`} class="specimen-plate">
              <div>
                <div
                  class="font-ui plate-muted"
                  style="display: flex; justify-content: space-between; font-size: 0.72rem; margin-bottom: 0.75rem; font-variant-numeric: tabular-nums;"
                >
                  <span>
                    CH. {String(index + 1).padStart(2, '0')} / {guide.data.category}
                  </span>
                  <span>{stats.minutes} MIN</span>
                </div>

                <h3
                  class="font-display"
                  style="font-size: 1.65rem; font-weight: 700; margin: 0 0 0.65rem; line-height: 1.02;"
                >
                  {guide.data.shortTitle ?? guide.data.title}
                </h3>

                <p class="plate-muted" style="font-size: 0.9rem; line-height: 1.48; margin: 0 0 1.25rem;">
                  {guide.data.description}
                </p>
              </div>

              {visual && (
                <div class="plate-media" style="aspect-ratio: 16 / 10; margin-top: auto;">
                  <Image
                    src={visual.image}
                    alt={visual.alt}
                    width={640}
                    quality={82}
                  />
                </div>
              )}
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- 3. INTERACTIVE 3-BLOCK WOODBLOCK REGISTRATION DEMONSTRATOR -->
  <WoodblockLayerDemo />

  <!-- 4. PHOTOGRAPHIC PROCESS STRIP ("How Cloth Moves Through Bagru") -->
  <section class="wrap reveal" style="padding-top: 5.5rem; padding-bottom: 5rem;">
    <div class="editorial-bar">
      <span>Workshop sequence — Five stages from raw timber to sun-cured cloth</span>
      <span>Bagru, Rajasthan (GI #183)</span>
    </div>

    <h2
      class="font-display"
      style="font-size: clamp(2.2rem, 4.5vw, 3.8rem); font-weight: 700; margin: 1.5rem 0 2.5rem;"
    >
      How cloth moves through Bagru
    </h2>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;"
    >
      {
        processSteps.map((step) => (
          <figure style="margin: 0; background: var(--surface); border: 1px solid var(--rule-light); display: flex; flex-direction: column;">
            <div class="plate-media" style="aspect-ratio: 4 / 5;">
              <Image src={step.image} alt={step.alt} width={520} quality={82} />
            </div>
            <figcaption style="padding: 1.1rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div
                  class="font-ui"
                  style="display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--madder); font-weight: 600; margin-bottom: 0.45rem;"
                >
                  <span>STAGE {step.num}</span>
                  <span>{step.term}</span>
                </div>
                <p
                  class="font-display"
                  style="font-size: 1.35rem; font-weight: 700; margin: 0 0 0.45rem;"
                >
                  {step.title}
                </p>
                <p style="margin: 0; font-size: 0.86rem; line-height: 1.48; color: var(--ink-muted);">
                  {step.desc}
                </p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- 5. BOTANICAL DYE CHEMISTRY EXPLORER + HISTORICAL PLATES -->
  <section class="wrap reveal" style="padding-bottom: 5.5rem;">
    <div class="editorial-bar">
      <span>Botanical chemistry — Six natural pigments of Rajasthan</span>
      <span>Select a swatch to inspect</span>
    </div>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; align-items: end; margin-top: 1.5rem;"
    >
      <h2
        class="font-display"
        style="font-size: clamp(2.2rem, 4.5vw, 3.6rem); font-weight: 700; margin: 0;"
      >
        Living color from earth, iron &amp; root
      </h2>
      <p style="margin: 0; color: var(--ink-muted); font-size: 0.96rem;">
        Every traditional Bagru colorway comes from plant tannins, mineral salts, and fermentation—
        bonding chemically inside cotton yarn rather than gluing plastic pigment on top.
      </p>
    </div>

    <NaturalDyePalette />

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; margin-top: 1.25rem;"
    >
      <figure class="museum-figure" style="margin: 0; background: var(--surface); padding: 1rem; border: 1px solid var(--rule-light);">
        <div class="plate-media" style="aspect-ratio: 16 / 10;">
          <Image
            src={PHOTOS.indigoVats}
            alt="Historical 19th-century photograph of workers beating sunken indigo oxidation vats"
            width={820}
            quality={84}
          />
        </div>
        <figcaption style="border-bottom: 0; padding-bottom: 0;">
          <span>Archival plate: Indigo factory, beating the vats (c. 1890)</span>
          <a href="/guides/natural-dyes-and-mordants-for-block-printing/" style="color: var(--madder); font-weight: 600;">
            Read dye chemistry
          </a>
        </figcaption>
      </figure>

      <figure class="museum-figure" style="margin: 0; background: var(--surface); padding: 1rem; border: 1px solid var(--rule-light);">
        <div class="plate-media" style="aspect-ratio: 16 / 10; background: #14171c;">
          <Image
            src={PHOTOS.priestKing}
            alt="Mohenjo-daro steatite bust of the Priest-King wearing a repeating trefoil cloak"
            width={820}
            quality={84}
          />
        </div>
        <figcaption style="border-bottom: 0; padding-bottom: 0;">
          <span>Mohenjo-daro Priest-King (c. 2000 BCE): repeating trefoil cloth</span>
          <a href="/guides/sanganer-and-ajrakh-traditions/" style="color: var(--madder); font-weight: 600;">
            Explore regional clusters
          </a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 6. THE MAKERS & CULTURAL IP (CONSENT · CREDIT · COMPENSATION) -->
  <section class="band-dark reveal" style="padding: 5.5rem 0;">
    <div class="wrap">
      <div class="editorial-bar editorial-bar--dark">
        <span>The Makers &amp; Cultural IP — Consent, Credit, Compensation</span>
        <span>Mahila Print · CIPRI · Bagru</span>
      </div>

      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; align-items: end; margin: 1.75rem 0 2.75rem;"
      >
        <h2
          class="font-display"
          style="font-size: clamp(2.3rem, 4.8vw, 4rem); font-weight: 700; margin: 0; color: #fff;"
        >
          Name the people who made the cloth
        </h2>
        <p style="margin: 0; color: var(--muted-on-dark); font-size: 0.98rem;">
          In 2009, cloth left Bagru at seven rupees a meter through eight sets of hands—the maker’s
          name erased along the way. Through Studio Bagru and <strong>Mahila Print</strong>,
          women printers like Chandrakanta Chhipa carry full attribution and a direct 5% royalty on
          every design they draw.
        </p>
      </div>

      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;"
      >
        <figure style="margin: 0; border: 1px solid #2e2d29; background: #181816;">
          <div class="plate-media" style="aspect-ratio: 4 / 4;">
            <Image
              src={PHOTOS.khilana}
              alt="Khilana block print design created by Chandrakanta Chhipa in 2018 for Mahila Print"
              width={600}
              quality={85}
            />
          </div>
          <figcaption class="font-ui" style="padding: 1rem; font-size: 0.8rem;">
            <strong style="display: block; color: #fff;">Khilana — Chandrakanta Chhipa</strong>
            <span style="color: var(--muted-on-dark);">2018, &copy;Mahila Print · 5% artisan royalty</span>
          </figcaption>
        </figure>

        <figure style="margin: 0; border: 1px solid #2e2d29; background: #181816;">
          <div class="plate-media" style="aspect-ratio: 4 / 4;">
            <Image
              src={PHOTOS.deepakChhipa}
              alt="Deepak Chhipa standing before a wall of hand-carved wooden printing blocks in Bagru"
              width={600}
              quality={85}
            />
          </div>
          <figcaption class="font-ui" style="padding: 1rem; font-size: 0.8rem;">
            <strong style="display: block; color: #fff;">Deepak Chhipa</strong>
            <span style="color: var(--muted-on-dark);">Bagru master workshop &amp; woodblock archive</span>
          </figcaption>
        </figure>

        <figure style="margin: 0; border: 1px solid #2e2d29; background: #181816;">
          <div class="plate-media" style="aspect-ratio: 4 / 4;">
            <Image
              src={PHOTOS.vijendraAndYash}
              alt="Vijendra and Yash Chhipa in their family block-printing workshop in Bagru"
              width={600}
              quality={85}
            />
          </div>
          <figcaption class="font-ui" style="padding: 1rem; font-size: 0.8rem;">
            <strong style="display: block; color: #fff;">Vijendra &amp; Yash Chhipa</strong>
            <span style="color: var(--muted-on-dark);">Generational Chhipa family workshop, Bagru</span>
          </figcaption>
        </figure>

        <figure style="margin: 0; border: 1px solid #2e2d29; background: #181816;">
          <div class="plate-media" style="aspect-ratio: 4 / 4;">
            <Image
              src={PHOTOS.printingAjrakhTable}
              alt="Bagru woman printer guiding a visitor's hand over a carved wooden printing block"
              width={600}
              quality={85}
            />
          </div>
          <figcaption class="font-ui" style="padding: 1rem; font-size: 0.8rem;">
            <strong style="display: block; color: #fff;">The Printing Tables of Bagru</strong>
            <span style="color: var(--muted-on-dark);">Hands-on craft transmission &amp; direct sourcing</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 7. JEREMY FRITZHAND FIELD ORIGIN + STUDIO TOOLS + FAQS -->
  <section class="wrap reveal" style="padding-top: 5.5rem; padding-bottom: 5rem;">
    <div class="editorial-bar">
      <span>Author &amp; Field Origin — Sixteen years in Bagru</span>
      <span>2009 — 2026</span>
    </div>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 3rem; align-items: center; margin-top: 2.25rem;"
    >
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem;">
        <figure style="margin: 0;">
          <div class="plate-media" style="aspect-ratio: 4 / 5; border: 1px solid var(--rule-light);">
            <Image
              src={PHOTOS.jeremyDye2010}
              alt="Jeremy Fritzhand stirring a copper dye vat in Bagru, Rajasthan in 2010 during his Minerva Fellowship"
              width={540}
              quality={84}
            />
          </div>
          <figcaption class="font-ui" style="margin-top: 0.4rem; font-size: 0.72rem; color: var(--ink-muted);">
            Bagru dye cauldron, 2010
          </figcaption>
        </figure>
        <figure style="margin: 0;">
          <div class="plate-media" style="aspect-ratio: 4 / 5; border: 1px solid var(--rule-light);">
            <Image
              src={PHOTOS.jeremy2026}
              alt="Portrait of Jeremy Fritzhand, author of Blockprinting.org and founder of Studio Bagru and Fritz MFG"
              width={540}
              quality={88}
            />
          </div>
          <figcaption class="font-ui" style="margin-top: 0.4rem; font-size: 0.72rem; color: var(--ink-muted);">
            Jeremy Fritzhand, 2026
          </figcaption>
        </figure>
      </div>

      <div>
        <h2
          class="font-display"
          style="font-size: clamp(2rem, 3.8vw, 3.1rem); font-weight: 700; margin: 0;"
        >
          “When the work is done, the people will say: we have done this ourselves.”
        </h2>
        <p style="margin-top: 1.1rem; color: var(--ink-muted);">
          After sixteen years building Bagru Textiles (2010), Studio Bagru (2016), Mahila Print
          (2018), and Fritz MFG (2023), the families we worked with now take their own international
          orders directly. <strong>Blockprinting.org</strong> exists so every designer, student, and
          researcher has direct, honest access to the craft—with zero middlemen and zero myths.
        </p>

        <div class="font-ui" style="display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; font-size: 0.82rem; font-weight: 600;">
          <a href="/about/" style="background: var(--ink); color: #fff; padding: 0.75rem 1.25rem;">
            Read Jeremy’s full story
          </a>
          <a href="/tools/yardage-calculator/" style="border: 1px solid var(--ink); padding: 0.75rem 1.25rem;">
            Open yardage calculator
          </a>
          <a href="/glossary/" style="border: 1px solid var(--rule-light); background: var(--surface); padding: 0.75rem 1.25rem;">
            24-term glossary
          </a>
        </div>
      </div>
    </div>

    <div style="margin-top: 4rem; max-width: 46rem;">
      <FaqSection items={homeFaqs} />
    </div>
  </section>
</BaseLayout>
