---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE } from '../config/site';
import { estimateReadingTime, formatDate } from '../lib/seo';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const homeFaqs = [
  {
    question: 'Who writes Blockprinting.org?',
    answer:
      'Blockprinting.org is written by Jeremy Fritzhand, who first arrived in Bagru, Rajasthan in 2010 as a Minerva Fellow from Union College and went on to found Studio Bagru and Fritz MFG to connect traditional Indian hand block printers directly with independent designers worldwide.',
  },
  {
    question: 'What makes Bagru hand block printing different from Sanganeri or Ajrakh?',
    answer:
      'Bagru is defined by its 400-year-old Chhipa tradition of earthy, natural-ground prints and dabu (mud-resist) printing with clay, lime, and sawdust. Sanganer favors delicate floral motifs on bright white cloth, while Ajrakh from Kutch is a 14-to-16-step double-sided resist-dyeing craft anchored in deep indigo and madder red.',
  },
  {
    question: 'How can independent designers source hand block printed fabric ethically?',
    answer:
      'Start by working directly with artisan-owned workshops rather than opaque export intermediaries, respect realistic production lead times around weather and sun-drying, pay fair rates for both carving and printing, and honor artisan design rights—principles developed through Studio Bagru and Mahila Print.',
  },
];
---

<BaseLayout
  isHome
  title={SITE.title}
  description={SITE.description}
  image="/og/home.png"
  faqs={homeFaqs}
>
  <section class="border-b border-border pb-12">
    <p class="text-xs font-semibold tracking-[0.18em] text-vermilion uppercase">
      By Jeremy Fritzhand &middot; Bagru, Craft &amp; Ethical Textiles
    </p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Hand Block Printing, Natural Dyes &amp; the Makers Keeping Craft Alive
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
      I first arrived in Bagru, Rajasthan in 2010 as a Minerva Fellow and never really left the
      printing table behind. After more than a decade working alongside Chhipa printers, teakwood
      block carvers, and natural dyers through Studio Bagru and Fritz MFG, I built this archive to
      document the real techniques, chemistry, and economics of hand block printing.
    </p>
    <div class="mt-7 flex flex-wrap gap-4">
      <a
        href="/guides/"
        class="inline-flex items-center rounded-md bg-indigo px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-indigo-dark"
      >
        Read the Guides
      </a>
      <a
        href="/about/"
        class="inline-flex items-center rounded-md border border-border bg-paper-alt/60 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-indigo hover:text-indigo"
      >
        About Jeremy Fritzhand
      </a>
    </div>
  </section>

  <section aria-labelledby="pillars-heading" class="mt-12 grid gap-6 sm:grid-cols-3">
    <h2 id="pillars-heading" class="sr-only">Core focus areas</h2>
    <article class="rounded-lg border border-border bg-paper-alt/40 p-6">
      <h3 class="text-xl font-bold text-ink">Workshop Craft &amp; Dabu</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        First-hand breakdowns of carved teakwood <em>rekh</em>, <em>datta</em>, and <em>gadh</em>{' '}
        blocks, Bagru mud-resist (<em>dabu</em>), and multi-color hand registration.
      </p>
    </article>
    <article class="rounded-lg border border-border bg-paper-alt/40 p-6">
      <h3 class="text-xl font-bold text-ink">Botanical Dye Chemistry</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        Practical notes on <em>harda</em> pre-mordanting, fermented iron-jaggery black, alum and
        madder reds, natural indigo vats, and guar or tamarind seed thickeners.
      </p>
    </article>
    <article class="rounded-lg border border-border bg-paper-alt/40 p-6">
      <h3 class="text-xl font-bold text-ink">Ethical Supply Chains</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        Lessons from Studio Bagru, Mahila Print, and Fritz MFG on transparent sourcing, artisan
        design rights, and building direct bridges without middlemen.
      </p>
    </article>
  </section>

  <section aria-labelledby="guides-heading" class="mt-14">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="guides-heading" class="text-2xl font-bold text-ink sm:text-3xl">
        Field Notes &amp; Guides
      </h2>
      <a href="/guides/" class="text-sm font-semibold text-indigo hover:underline">
        View all guides &rarr;
      </a>
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        guides.map((guide) => {
          const stats = estimateReadingTime(guide.body ?? '');
          return (
            <article class="flex flex-col justify-between rounded-lg border border-border bg-paper p-6 transition-colors hover:border-indigo">
              <div>
                <div class="flex items-center gap-3 text-xs font-semibold tracking-wider text-vermilion uppercase">
                  <span>{guide.data.category}</span>
                  <span aria-hidden="true" class="text-border">
                    &bull;
                  </span>
                  <span class="text-ink-muted">{stats.minutes} min read</span>
                </div>
                <h3 class="mt-2 text-2xl font-bold text-ink">
                  <a
                    href={`/guides/${guide.id}/`}
                    class="transition-colors hover:text-indigo hover:underline"
                  >
                    {guide.data.title}
                  </a>
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{guide.data.description}</p>
              </div>
              <div class="mt-5 flex items-center justify-between border-t border-border/70 pt-4 text-xs text-ink-muted">
                <span>
                  By <strong class="font-medium text-ink">{guide.data.author}</strong> &middot;{' '}
                  <time datetime={guide.data.publishedAt.toISOString()}>
                    {formatDate(guide.data.publishedAt)}
                  </time>
                </span>
                <a
                  href={`/guides/${guide.id}/`}
                  class="font-semibold text-indigo hover:underline"
                >
                  Read &rarr;
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <FaqSection items={homeFaqs} />
</BaseLayout>
