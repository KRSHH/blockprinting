---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404)"
  description="The page you requested could not be found on Blockprinting.org. Explore the encyclopedia, photographic archive, or glossary."
  noindex
>
  <section class="wrap-reading" style="padding: 5rem 1.5rem;">
    <div class="editorial-bar">
      <span>Error 404</span>
      <span>Blockprinting.org</span>
    </div>
    <h1 class="font-display" style="font-size: clamp(2.8rem, 6vw, 4.8rem); font-weight: 700; margin: 1.5rem 0 1rem;">
      Page not found
    </h1>
    <p style="color: var(--ink-muted); max-width: 34rem; font-size: 1.05rem;">
      The page you requested has moved or does not exist. Start from the{' '}
      <a href="/" style="text-decoration: underline;">encyclopedia homepage</a>, browse the{' '}
      <a href="/archive/" style="text-decoration: underline;">photographic archive</a>, or look up a
      term in the <a href="/glossary/" style="text-decoration: underline;">glossary</a>.
    </p>
  </section>
</BaseLayout>
