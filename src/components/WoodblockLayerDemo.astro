---
// Interactive 3-Block Woodblock Registration Demonstrator (Rekh + Datta + Gadh)
---

<section class="band-dark" style="padding: 5rem 0;">
  <div class="wrap">
    <div class="editorial-bar editorial-bar--dark">
      <span>Interactive plate — Multi-block registration</span>
      <span>Rekh · Datta · Gadh</span>
    </div>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; align-items: center; margin-top: 2.25rem;"
    >
      <!-- Visual SVG Printing Canvas -->
      <div
        style="background: #f5f0e3; border: 1px solid #3a3934; padding: 2rem; position: relative;"
      >
        <div
          class="font-ui"
          style="display: flex; justify-content: space-between; font-size: 0.72rem; color: #52514d; margin-bottom: 1rem;"
        >
          <span>HARDA-TREATED COTTON GROUND</span>
          <span id="layer-status">3 OF 3 BLOCKS STAMPED</span>
        </div>

        <svg
          id="woodblock-svg"
          viewBox="0 0 360 360"
          role="img"
          aria-label="Interactive diagram of three carved woodblock layers: Rekh outline, Datta background, and Gadh filler"
          style="width: 100%; max-width: 380px; margin: 0 auto; display: block; overflow: visible;"
        >
          <!-- Subtle woven cloth grid -->
          <defs>
            <pattern id="weave" width="8" height="8" patternUnits="userSpaceOnUse">
              <path d="M 8 0 L 0 0 0 8" fill="none" stroke="#e3dbc6" stroke-width="0.6" />
            </pattern>
          </defs>
          <rect x="0" y="0" width="360" height="360" fill="url(#weave)" />

          <!-- Corner Gudh registration marks -->
          <g stroke="#8a816e" stroke-width="1.2" fill="none">
            <path d="M18 30 V18 H30" />
            <path d="M330 18 H342 V30" />
            <path d="M18 330 V342 H30" />
            <path d="M330 342 H342 V330" />
          </g>

          <!-- LAYER 2: DATTA (Background indigo block) -->
          <g id="layer-datta" style="transition: opacity 0.35s ease, transform 0.25s ease;">
            <path
              d="M44 44 H316 V316 H44 Z M180 78 C215 112 248 145 248 180 C248 215 215 248 180 282 C145 248 112 215 112 180 C112 145 145 112 180 78 Z"
              fill="#1b3a6b"
              fill-rule="evenodd"
              opacity="0.9"
            />
            <circle cx="80" cy="80" r="14" fill="#f5f0e3" />
            <circle cx="280" cy="80" r="14" fill="#f5f0e3" />
            <circle cx="80" cy="280" r="14" fill="#f5f0e3" />
            <circle cx="280" cy="280" r="14" fill="#f5f0e3" />
          </g>

          <!-- LAYER 3: GADH (Filler madder red & ochre petals) -->
          <g id="layer-gadh" style="transition: opacity 0.35s ease, transform 0.25s ease;">
            <path d="M180 100 C198 128 202 152 180 176 C158 152 162 128 180 100 Z" fill="#b3261e" />
            <path d="M180 260 C198 232 202 208 180 184 C158 208 162 232 180 260 Z" fill="#b3261e" />
            <path d="M100 180 C128 162 152 158 176 180 C152 202 128 198 100 180 Z" fill="#b3261e" />
            <path d="M260 180 C232 162 208 158 184 180 C208 202 232 198 260 180 Z" fill="#b3261e" />
            <circle cx="180" cy="180" r="18" fill="#c99d3b" />
            <circle cx="80" cy="80" r="7" fill="#b3261e" />
            <circle cx="280" cy="80" r="7" fill="#b3261e" />
            <circle cx="80" cy="280" r="7" fill="#b3261e" />
            <circle cx="280" cy="280" r="7" fill="#b3261e" />
          </g>

          <!-- LAYER 1: REKH (Outline fermented iron syahi black) -->
          <g
            id="layer-rekh"
            fill="none"
            stroke="#161513"
            stroke-width="3.2"
            stroke-linejoin="round"
            style="transition: opacity 0.35s ease;"
          >
            <rect x="44" y="44" width="272" height="272" />
            <path
              d="M180 78 C215 112 248 145 248 180 C248 215 215 248 180 282 C145 248 112 215 112 180 C112 145 145 112 180 78 Z"
            />
            <path d="M180 100 C198 128 202 152 180 176 C158 152 162 128 180 100 Z" />
            <path d="M180 260 C198 232 202 208 180 184 C158 208 162 232 180 260 Z" />
            <path d="M100 180 C128 162 152 158 176 180 C152 202 128 198 100 180 Z" />
            <path d="M260 180 C232 162 208 158 184 180 C208 202 232 198 260 180 Z" />
            <circle cx="180" cy="180" r="18" />
            <circle cx="180" cy="180" r="5" fill="#161513" />
          </g>
        </svg>
      </div>

      <!-- Controls & Explanation -->
      <div>
        <h2
          class="font-display"
          style="font-size: clamp(2.1rem, 4vw, 3.3rem); font-weight: 700; margin: 0; color: #fff;"
        >
          How three carved blocks lock into one print
        </h2>
        <p style="margin-top: 1rem; color: var(--muted-on-dark); max-width: 34rem;">
          A classic Bagru print is never stamped in one pass. Master carvers cut a matched set of
          teakwood blocks—each aligned by eye across a five-meter table using corner{' '}
          <em>gudh</em> registration pins. Toggle the blocks below and slide the hand-offset to see
          why authentic hand block printing always carries subtle human movement.
        </p>

        <div
          class="font-ui"
          style="display: grid; gap: 0.65rem; margin-top: 1.75rem; font-size: 0.84rem;"
        >
          <label
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid #302f2b; background: #191917; cursor: pointer;"
          >
            <span>
              <input id="toggle-rekh" type="checkbox" checked style="margin-right: 0.65rem; accent-color: #b3261e;" />
              <strong>Rekh</strong> — Outline block (<em>syahi</em> iron black)
            </span>
            <span style="display: inline-block; width: 14px; height: 14px; background: #161513; border: 1px solid #666;"></span>
          </label>

          <label
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid #302f2b; background: #191917; cursor: pointer;"
          >
            <span>
              <input id="toggle-datta" type="checkbox" checked style="margin-right: 0.65rem; accent-color: #b3261e;" />
              <strong>Datta</strong> — Background block (<em>neel</em> indigo)
            </span>
            <span style="display: inline-block; width: 14px; height: 14px; background: #1b3a6b;"></span>
          </label>

          <label
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid #302f2b; background: #191917; cursor: pointer;"
          >
            <span>
              <input id="toggle-gadh" type="checkbox" checked style="margin-right: 0.65rem; accent-color: #b3261e;" />
              <strong>Gadh</strong> — Filler block (alum + <em>manjistha</em> madder)
            </span>
            <span style="display: inline-block; width: 14px; height: 14px; background: #b3261e;"></span>
          </label>
        </div>

        <div class="font-ui" style="margin-top: 1.5rem; font-size: 0.8rem;">
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem;">
            <label for="reg-offset" style="color: var(--muted-on-dark);">
              Hand registration micro-shift (proof of the human hand)
            </label>
            <span id="reg-value" style="color: #fff; font-weight: 600;">+1.2 mm</span>
          </div>
          <input
            id="reg-offset"
            type="range"
            min="-4"
            max="4"
            step="0.4"
            value="1.2"
            style="width: 100%; accent-color: #b3261e;"
          />
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const rekh = document.getElementById('layer-rekh');
      const datta = document.getElementById('layer-datta');
      const gadh = document.getElementById('layer-gadh');
      const tRekh = document.getElementById('toggle-rekh');
      const tDatta = document.getElementById('toggle-datta');
      const tGadh = document.getElementById('toggle-gadh');
      const slider = document.getElementById('reg-offset');
      const regVal = document.getElementById('reg-value');
      const status = document.getElementById('layer-status');

      function update() {
        const cRekh = tRekh.checked;
        const cDatta = tDatta.checked;
        const cGadh = tGadh.checked;
        const shift = Number(slider.value);

        rekh.style.opacity = cRekh ? '1' : '0';
        datta.style.opacity = cDatta ? '1' : '0';
        gadh.style.opacity = cGadh ? '1' : '0';

        datta.style.transform = `translate(${shift * 1.4}px, ${-shift * 0.9}px)`;
        gadh.style.transform = `translate(${-shift * 1.6}px, ${shift * 1.2}px)`;

        const active = [cRekh, cDatta, cGadh].filter(Boolean).length;
        status.textContent = `${active} OF 3 BLOCKS STAMPED`;
        regVal.textContent = shift === 0 ? '0.0 mm (machine)' : `${shift > 0 ? '+' : ''}${shift.toFixed(1)} mm`;
      }

      [tRekh, tDatta, tGadh, slider].forEach((el) => el && el.addEventListener('input', update));
      update();
    })();
  </script>
</section>
