---
import type { BreadcrumbItem } from '../lib/schema';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-ink-muted">
      <ol class="flex flex-wrap items-center gap-2">
        {items.map((item, idx) => {
          const isLast = idx === items.length - 1;
          return (
            <li class="flex items-center gap-2">
              {idx > 0 && (
                <span aria-hidden="true" class="text-border">
                  /
                </span>
              )}
              {isLast ? (
                <span aria-current="page" class="font-medium text-ink">
                  {item.name}
                </span>
              ) : (
                <a href={item.href} class="transition-colors hover:text-indigo hover:underline">
                  {item.name}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
