---
import type { FaqItem } from '../lib/schema';

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Frequently Asked Questions' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="faq-heading" class="mt-14 border-t border-border pt-10">
      <h2 id="faq-heading" class="text-2xl font-bold text-ink sm:text-3xl">
        {heading}
      </h2>
      <div class="mt-6 divide-y divide-border rounded-lg border border-border bg-paper-alt/40">
        {items.map((faq) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg font-semibold text-ink">
              <span>{faq.question}</span>
              <span
                aria-hidden="true"
                class="text-xl text-indigo transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-ink-muted">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
