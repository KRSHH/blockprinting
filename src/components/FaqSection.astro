---
import type { FaqItem } from '../lib/schema';

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Common questions' } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="faq-heading" class="qa-section book-prose">
      <h2 id="faq-heading" style="border-top: 0; margin-top: 0; padding-top: 0; margin-bottom: 1.25rem;">
        {heading}
      </h2>
      {items.map((faq) => (
        <div class="qa-item">
          <p class="qa-q">{faq.question}</p>
          <p class="qa-a">{faq.answer}</p>
        </div>
      ))}
    </section>
  )
}
