{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blockprinting",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "blockprinting.org",
      "custom_domain": true
    },
    {
      "pattern": "www.blockprinting.org",
      "custom_domain": true
    }
  ]
}
