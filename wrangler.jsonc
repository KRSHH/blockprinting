{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blockprinting",
  "compatibility_date": "2026-11-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "blockprinting.org",
      "custom_domain": true
    },
    {
      "pattern": "www.blockprinting.org",
      "custom_domain": true
    }
  ]
}
